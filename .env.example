DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=
OPENROUTER_API_KEY=
MAGPIE_MODEL=
# Optional: cheaper model for the extraction pass only (the biggest token sink).
# Unset = every call uses MAGPIE_MODEL.
MAGPIE_EXTRACT_MODEL=
MAGPIE_DB_PATH=
BROWSER_PROFILE_DIR=
HEADLESS=
# Optional: Playwright `channel` (e.g. chrome) to launch a real Chrome install
# instead of bundled Chromium. Unset preserves current behavior.
BROWSER_CHANNEL=
# Craigslist region subdomain (e.g. sfbay) — required to use the opt-in craigslist source.
CRAIGSLIST_REGION=
